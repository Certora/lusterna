#!/usr/bin/env bash
set -eo pipefail
unset RUST_LOG

ENTRYPOINTS=({entrypoints})
OPAQUE=({opaque})

cd "$(dirname "$0")/.."

args=()
for p in "${ENTRYPOINTS[@]}"; do args+=(--start-from "$p"); done
for p in "${OPAQUE[@]}"; do args+=(--opaque "$p"); done

charon cargo --preset=aeneas "${args[@]}" --dest-file "$PWD/lusterna/extraction.llbc" -- --release --features lusterna
aeneas -backend lean -split-files -subdir Extraction -dest lusterna/lean lusterna/extraction.llbc