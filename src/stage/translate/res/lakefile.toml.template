name = "Extraction"
defaultTargets = ["Extraction"]

[[require]]
name = "aeneas"
git = "https://github.com/AeneasVerif/aeneas.git"
rev = "{rev}"
subDir = "backends/lean"

[[require]]
name = "lusternaSpec"
path = "{lusterna_spec_root}"

[[lean_lib]]
name = "Extraction"
globs = ["Extraction.+"]

[[lean_lib]]
name = "Spec"
globs = ["Spec.+"]
moreLeanArgs = ["--memory=8192"]
